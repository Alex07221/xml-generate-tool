<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <appSettings>
    <add key="appName" value="我的应用程序" />
    <add key="version" value="1.0.0" />
    <add key="debugMode" value="true" />
    <add key="maxConnections" value="100" />
    <add key="timeout" value="30" />
  </appSettings>
  <database>
    <connectionStrings>
      <add name="DefaultConnection" connectionString="Server=localhost;Database=MyDB;Uid=root;Pwd=oldpass;" providerName="MySql" />
    </connectionStrings>
  </database>
  <logging>
    <level value="INFO" />
    <file path="logs/app.log" />
    <maxSize value="10MB" />
  </logging>
  <features>
    <feature name="auth" enabled="true" />
    <feature name="cache" enabled="true" />
    <feature name="payment" enabled="false" />
  </features>
</configuration>
